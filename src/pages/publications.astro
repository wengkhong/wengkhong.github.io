---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const publications = await getCollection("publications");
const sorted = publications.sort((a, b) => {
  const pa = a.data.priority ?? 99;
  const pb = b.data.priority ?? 99;
  if (pa !== pb) return pa - pb;
  return b.data.year - a.data.year;
});

const roleLabels: Record<string, string> = {
  first: "First author",
  cofirst: "Co-first author",
  senior: "Senior author",
  cosenior: "Co-senior author",
  contributor: "Contributing author",
};

function formatCitation(pub: (typeof publications)[number]) {
  const d = pub.data;
  const bits: string[] = [];
  if (d.volume) bits.push(d.volume + (d.issue ? `(${d.issue})` : "") + (d.pages ? `:${d.pages}` : ""));
  return bits.length ? `<em> ${d.journal}</em>, ${bits.join("")}.` : `<em> ${d.journal}</em>.`;
}

function highlightOwnName(authors: string) {
  // Bold "Lim WK" wherever it appears in the author string.
  return authors.replace(/Lim WK\b/g, "<strong class=\"pub-own\">Lim WK</strong>");
}
---

<MainLayout
  title="Publications | Weng Khong Lim"
  description="Selected publications in clinical and population genomics."
>
  <header class="section">
    <h1 class="page-title">Publications</h1>
    <p class="page-intro">
      Selected publications: clinically relevant variant interpretation in ancestrally diverse Asian
      populations, population-scale sequencing, and translational genomics.
    </p>
  </header>

  {sorted.map((pub) => (
    <section class={"section card pub-card" + (pub.data.featured ? " featured" : "")}>
      <p class="eyebrow">{pub.data.featured ? "Selected" : ""}</p>
      <h2 class="pub-authors" set:html={`${highlightOwnName(pub.data.authors)} (${pub.data.year})`} />
      <p class="pub-title">{pub.data.title}.</p>
      <p class="pub-journal" set:html={formatCitation(pub)} />
      <ul class="pub-tags">
        {pub.data.role && <li class="badge">{roleLabels[pub.data.role]}</li>}
        {pub.data.note && <li class="badge badge-note">{pub.data.note}</li>}
      </ul>
      {pub.body && <p class="pub-summary">{pub.body}</p>}
      {pub.data.doi && (
        <p class="pub-doi">
          <a
            class="button-link secondary"
            href={`https://doi.org/${pub.data.doi}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            DOI {pub.data.doi}
          </a>
        </p>
      )}
    </section>
  ))}

  <section class="section card">
    <h3>Full Publication List</h3>
    <p>Additional publications (including consortium and collaborative work) are available on Google Scholar.</p>
    <p>
      <a class="button-link secondary" href="https://scholar.google.com/citations?user=8lU-rEkAAAAJ&hl=en" aria-label="Google Scholar profile" target="_blank" rel="noopener noreferrer">
        Google Scholar
      </a>
    </p>
  </section>
</MainLayout>